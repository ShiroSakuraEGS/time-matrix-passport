{
  "manifest_version": 3,
  "name": "賽博時空簽證護照 - Cyber Time Passport",
  "version": "1.0.0",
  "description": "未來風/故障藝術風格的時空引渡護照計時器。具備賽博印章時鐘、分頁簽證總時長統計、即時串接與記錄至 Google 試算表。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "開啟賽博時空護照",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["sound.js", "passport-core.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "passport.css",
        "popup.html",
        "popup.js",
        "sound.js",
        "passport-core.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
